# Core
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# JWT secrets
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"
MONGODB_DB_NAME=authDB
MAX_SESSIONS=5

# Public frontend origins
CORS_ORIGIN=https://app.example.com,https://menu.example.com
ALLOWED_DEV_ORIGINS=
FRONTEND_URL=https://app.example.com
FALLBACK_FRONTEND_URL=https://app.example.com

# Email
EMAIL_PROVIDER=resend
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=replace-with-smtp-credential
SMTP_FROM=you@example.com
EMAIL_FROM_NAME=Qravy
EMAIL_REPLY_TO=you@example.com
RESEND_API_KEY=replace-me

# Rate limits and trial
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRIAL_DAYS=1

# AI menu import
OPENAI_API_KEY=replace-me
MENU_IMPORT_MODEL=gpt-4.1-mini
