# Core
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# JWT secrets
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"
MONGODB_DB_NAME=authDB
MAX_SESSIONS=5

# Public frontend origins
CORS_ORIGIN=https://app.example.com,https://menu.example.com
ALLOWED_DEV_ORIGINS=
FRONTEND_URL=https://app.example.com
FALLBACK_FRONTEND_URL=https://app.example.com

# Email
EMAIL_PROVIDER=resend
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=replace-with-smtp-credential
SMTP_FROM=you@example.com
EMAIL_FROM_NAME=Qravy
EMAIL_REPLY_TO=you@example.com
RESEND_API_KEY=replace-me

# Rate limits (optional — the defaults suit production; RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX are no longer read)
# RATE_LIMIT_MAX_API_USER=600     # API requests per minute per signed-in user
# RATE_LIMIT_MAX_API_IP=2000      # API requests per minute per IP for guests (a restaurant's Wi-Fi)
# RATE_LIMIT_MAX_AUTH=10          # login emails per address per 15 min
# RATE_LIMIT_MAX_EMAILS_IP=200    # login emails per IP per 15 min
# RATE_LIMIT_MAX_CORTEX_FAILS=10  # failed Cortex sign-ins per IP + account per 15 min
# RATE_LIMIT_MAX_CODE_FAILS=10    # wrong email codes per IP + email per 15 min
TRIAL_DAYS=1

# AI menu import
OPENAI_API_KEY=replace-me
MENU_IMPORT_MODEL=gpt-4.1
