{
	email {$TLS_EMAIL}

	# <restaurant>.qravy.com: a certificate per restaurant, issued on its first visit,
	# only after storefront-host confirms the restaurant exists.
	on_demand_tls {
		ask http://storefront-host:8090/internal/tls-ask
	}
}

(storefront) {
	@internal path /internal/*
	handle @internal {
		respond "Not Found" 404
	}

	@voice path /ws/voice
	handle @voice {
		reverse_proxy api-gateway:8080
	}

	@azure path /azure/*
	handle @azure {
		reverse_proxy api-gateway:8080
	}

	reverse_proxy storefront-host:8090
}

{$ADMIN_DOMAIN} {
	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	@voice path /ws/voice
	handle @voice {
		reverse_proxy api-gateway:8080
	}

	@alertTrigger path /waiter/internal/alert/trigger
	handle @alertTrigger {
		respond "Not Found" 404
	}

	handle_path /waiter/* {
		reverse_proxy ai-waiter-service:7081
	}

	@images path /i/*
	handle @images {
		reverse_proxy upload-service:4010
	}

	@azure path /azure/*
	handle @azure {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy braincell:80
	}
}

# Cortex — the company admin panel (Qravy staff only: its own sign-in). Not for search engines.
{$CORTEX_DOMAIN:cortex.qravy.com} {
	header X-Robots-Tag "noindex, nofollow"

	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy cortex:80
	}
}

# Old links and printed QR codes: {$STOREFRONT_DOMAIN}/t/<restaurant>
{$STOREFRONT_DOMAIN} {
	import storefront
}

# Online shop: <restaurant>.qravy.com — dine-in: <restaurant>.qravy.com/dine-in?table=12
*.qravy.com {
	tls {
		on_demand
	}
	import storefront
}
