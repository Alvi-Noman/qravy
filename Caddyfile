{
	email {$TLS_EMAIL}

	# <restaurant>.qravy.com: a certificate per restaurant, issued on its first visit,
	# only after storefront-host confirms the restaurant exists.
	on_demand_tls {
		ask http://storefront-host:8090/internal/tls-ask
	}
}

(storefront) {
	@internal path /internal/*
	handle @internal {
		respond "Not Found" 404
	}

	@voice path /ws/voice
	handle @voice {
		reverse_proxy api-gateway:8080
	}

	@azure path /azure/*
	handle @azure {
		reverse_proxy api-gateway:8080
	}

	reverse_proxy storefront-host:8090
}

{$ADMIN_DOMAIN} {
	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	@voice path /ws/voice
	handle @voice {
		reverse_proxy api-gateway:8080
	}

	@alertTrigger path /waiter/internal/alert/trigger
	handle @alertTrigger {
		respond "Not Found" 404
	}

	handle_path /waiter/* {
		reverse_proxy ai-waiter-service:7081
	}

	@images path /i/*
	handle @images {
		reverse_proxy upload-service:4010
	}

	@azure path /azure/*
	handle @azure {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy braincell:80
	}
}

# The dashboard's old address (it moved to {$ADMIN_DOMAIN}). Pages go through the handover (auth-service
# routes/handoverRoutes.ts), which carries the sign-in and a paired branch tablet across, then lands on the same page
# at the new address. The API, images, voice and waiter paths keep answering here — saved image links, tabs still open.
{$LEGACY_ADMIN_DOMAIN:app.qravy.com} {
	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	@voice path /ws/voice
	handle @voice {
		reverse_proxy api-gateway:8080
	}

	@alertTrigger path /waiter/internal/alert/trigger
	handle @alertTrigger {
		respond "Not Found" 404
	}

	handle_path /waiter/* {
		reverse_proxy ai-waiter-service:7081
	}

	@images path /i/*
	handle @images {
		reverse_proxy upload-service:4010
	}

	@azure path /azure/*
	handle @azure {
		reverse_proxy api-gateway:8080
	}

	handle {
		redir https://{host}/api/v1/auth/handover{uri} 302
	}
}

# Cortex — the company admin panel (Qravy staff only: its own sign-in). Not for search engines.
{$CORTEX_DOMAIN:cortex.qravy.com} {
	header X-Robots-Tag "noindex, nofollow"

	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy cortex:80
	}
}

# Old links and printed QR codes: {$STOREFRONT_DOMAIN}/t/<restaurant>
{$STOREFRONT_DOMAIN} {
	import storefront
}

# Online shop: <restaurant>.qravy.com — dine-in: <restaurant>.qravy.com/dine-in?table=12
# Every other host name, with a certificate per restaurant on its first visit — the on_demand_tls check (storefront-host
# /internal/tls-ask) only says yes to real restaurants (and Qravy's own hosts). Not "*.qravy.com": Caddy then treats
# app / menu / cortex as covered by that wildcard and never gives them their own certificates.
https:// {
	tls {
		on_demand
	}
	import storefront
}

# Plain http for those hosts → https (the named sites above get this automatically)
http:// {
	redir https://{host}{uri} 308
}
