ARG APP

FROM node:20-alpine AS build
ARG APP
ARG VITE_API_URL=/api/v1
ARG VITE_AI_WAITER_API=/waiter
ARG VITE_STOREFRONT_URL

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_AI_WAITER_API=${VITE_AI_WAITER_API}
ENV VITE_STOREFRONT_URL=${VITE_STOREFRONT_URL}

WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/config/package.json ./packages/config/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/${APP}/package.json ./apps/${APP}/package.json

RUN pnpm install --frozen-lockfile --filter ./apps/${APP}...

COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY apps/${APP} ./apps/${APP}

WORKDIR /repo/apps/${APP}
RUN pnpm run build

FROM nginx:1.27-alpine
ARG APP
COPY apps/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 80